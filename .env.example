# Perfox / OmniFlow Enterprise Platform — Express backend
# Copy to .env and adjust. Every value below has a working default in
# src/config/index.ts, so a missing entry will not stop the server booting.

# ---------------------------------------------------------------- server
# 5051 matches what the frontend's VITE_API_BASE_URL points at.
PORT=5051
# development | production — production switches the logger to JSON per line
# and turns the API docs off by default.
NODE_ENV=development

# -------------------------------------------------------------- database
MONGODB_URI=mongodb://localhost:27017/enterprise_platform

# ------------------------------------------------------------------ auth
# CHANGE THIS. Anyone holding it can mint a valid token for any account.
JWT_SECRET=your_jwt_secret_key_here
# Session length when "remember me" is ticked. Without it a token lasts 12h.
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------ cors
# Comma separated. An origin not listed here is rejected — there is no
# permissive fallback.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --------------------------------------------------------------- logging
# error | warn | log | debug — filtered before formatting, so debug costs
# nothing once it is switched off.
LOG_LEVEL=debug

# ------------------------------------------------------------------ docs
# Swagger UI at /api/docs and the raw spec at /api/docs.json.
# Defaults to true in development and false in production, where publishing
# the full surface with a Try-it button is rarely wanted.
ENABLE_DOCS=true

# ------------------------------------------------------------------ team
# Enforced server-side: creating a member past this limit returns 409.
TEAM_SEAT_LIMIT=10

# ------------------------------------------------------------- seed data
# Seeds the demo collections when they are empty, and repairs accounts left
# holding no usable password hash by the original seed data (they are given a
# real bcrypt hash of "password123" and a warning is logged).
# SET THIS TO false IN ANY SHARED ENVIRONMENT.
SEED_ON_BOOT=true

# --------------------------------------------------- perfox platform api
# Used by the conversations service to pull live threads from the Perfox
# workspace. Leave blank to run on local data only.
# The token is a workspace-wide secret: it can read, upload to and delete from
# the entire knowledge base. Never expose it to the browser, and never commit
# a real value here.
PERFOX_API_URL=https://<your-workspace>.perfox.ai/api/v1
PERFOX_API_TOKEN=Bearer sk_replace_me
